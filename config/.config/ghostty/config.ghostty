custom-shader = ./sonic_boom_cursor.glsl
custom-shader = ./cursor_warp.glsl
custom-shader = ./unfocused_cursor.glsl
background-opacity = 0.9
background-blur = 1
confirm-close-surface = false
adjust-cursor-thickness = 50%
font-family = JetBrains Mono
cursor-style = bar
shell-integration-features = no-cursor
font-size = 13
# ...
theme = noctalia
