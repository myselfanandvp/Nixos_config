window-rule{
  match is-active=false
  opacity 0.95
}


window-rule{
  match is-active=true
  opacity 1.0
}


window-rule {
  match title="float-term" 
  open-floating true 
  open-focused true
  default-column-width {proportion 0.60;}
  default-window-height {fixed 500;}
 match is-window-cast-target=true
    focus-ring {
        active-color "#f38ba8"
        inactive-color "#7d0d2d"
    }

    border {
        inactive-color "#7d0d2d"
    }

    shadow {
        color "#7d0d2d70"
