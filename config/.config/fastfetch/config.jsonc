{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "none",
    "color": {
      "1": "#e6b450",
      "2": "#aad94c"
    }
  },
  "display": {
    "separator": " ",
    "color": {
      "keys": "#e6b450",
      "title": "#aad94c"
    },
    "percent": {
      "color": {
        "green": "#39bae6",
        "yellow": "#efcf8f",
        "red": "#d95757"
      }
    }
  },
  "modules": [
    {
      "key": "╭────────────╮",
      "type": "custom",
      "format": "\u001b[35m\u001b[0m"
    },
    {
      "key": "│   user    │",
      "type": "title",
      "format": "{user-name}",
      "keyColor": "green"
    },
    {
      "key": "│ 󰇅 hname    │",
      "type": "title",
      "format": "{host-name}",
      "keyColor": "green"
    },
    {
      "key": "│ 󰅐 uptime   │",
      "type": "uptime",
      "keyColor": "yellow"
    },
    {
      "key": "│ 󰣇 distro   │",
      "type": "os",
      "keyColor": "blue"
    },
    {
      "key": "│  kernel   │",
      "type": "kernel",
      "keyColor": "blue"
    },
    {
      "key": "│  wm       │",
      "type": "wm",
      "keyColor": "cyan"
    },
    {
      "key": "│  term     │",
      "type": "terminal",
      "keyColor": "cyan"
    },
    {
      "key": "│ 󰛖 font     │",
      "type": "font",
      "keyColor": "cyan"
    },
    {
      "key": "│  shell    │",
      "type": "shell",
      "keyColor": "cyan"
    },
    {
      "key": "│ 󰍛 cpu      │",
      "type": "cpu",
      "showPeCoreCount": true,
      "keyColor": "red"
    },
    {
      "key": "│ 󰉉 disk     │",
      "type": "disk",
      "folders": "/",
      "keyColor": "red"
    },
    {
      "key": "│ 󰍛 memory   │",
      "type": "memory",
      "keyColor": "red"
    },
    {
      "key": "├────────────┤",
      "type": "custom",
      "format": "\u001b[35m\u001b[0m"
    },
    {
      "key": "│ PC         │",
      "type": "host",
      "format": "{5} {1} ({2})",
      "keyColor": "green"
    },
    {
      "key": "│ ├ 󰢮 gpu    │",
      "type": "gpu",
      "format": "{1} {2} @ {12}",
      "keyColor": "yellow"
    },
    {
      "key": "│ ├ 󰓡 swap   │",
      "type": "swap",
      "keyColor": "yellow"
    },
    {
      "key": "│ ├ 󰍹 disp   │",
      "type": "monitor",
      "format": "{1} px @ {2} Hz - {3} mm ({4} inches, {5} pp)",
      "keyColor": "blue"
    },
    {
      "key": "│ ├  dtime  │",
      "type": "command",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days",
      "keyColor": "magenta"
    },
    {
      "key": "│ └  colors │",
      "type": "colors",
      "symbol": "circle"
    },
    {
      "key": "╰────────────╯",
      "type": "custom",
      "format": "\u001b[35m\u001b[0m"
    }
  ]
}
