binds {
    // Scroll through windows (columns) to the right

    Mod+Q hotkey-overlay-title="Close Opened windows" { close-window; }
    Mod+WheelScrollDown { focus-column-right; }
    
    // Scroll through windows (columns) to the left
    Mod+WheelScrollUp   { focus-column-left; }
    
    // Optional: Use Super + Shift + Scroll to move between vertical workspaces
    Mod+Shift+WheelScrollDown { focus-workspace-down; }
    Mod+Shift+WheelScrollUp   { focus-workspace-up; }

    // Launch applications

    Mod+B hotkey-overlay-title="Open A Terminal: Btop" {spawn "sh" "-c" "~/.config/niri/scripts/btop_toggle.sh";}
    Mod+P hotkey-overlay-title="Open Color-picker" {spawn-sh "niri msg pick-color  | grep -o '#[0-9a-fA-F]\\{6\\}' | wl-copy";}
    Mod+RETURN hotkey-overlay-title="Open A Terminal: Kitty" { spawn "kitty"; }
    ALT+RETURN hotkey-overlay-title="Open A Terminal: Ghostty" { spawn "ghostty"; }
    Mod+T hotkey-overlay-title="Open A Terminal:Kitty (Floating)" {spawn "sh" "-c" "~/.config/niri/scripts/kitty_toggle.sh";}
    Mod+ALT+B hotkey-overlay-title="Open A Google Chrome Window" { spawn "google-chrome"; }
    Mod+ALT+C hotkey-overlay-title="Open A LazyVim Window" { spawn-sh "kitty -e nvim"; }
    Mod+ALT+E hotkey-overlay-title="Open File Explore  Window" { spawn "nautilus"; }
    Mod+E hotkey-overlay-title="Open Yazi Explore Window" {spawn "sh" "-c" "~/.config/niri/scripts/yazi.sh";}
    Mod+Alt+D hotkey-overlay-title="To Open LazyDocker" {spawn-sh "kitty -e lazydocker";}


    // // Core Noctalia binds (V5)
    Mod+SPACE hotkey-overlay-title="Open The Application Launcher" { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+N hotkey-overlay-title="Open The Notepad" { spawn-sh "noctalia msg panel-toggle noctalia/notes:panel"; }
    Mod+S hotkey-overlay-title="Open The Control Panel" { spawn-sh "noctalia msg panel-toggle control-center"; }
    Mod+Comma hotkey-overlay-title="Open The Setting Panel" { spawn-sh "noctalia msg settings-toggle"; }
    Mod+X hotkey-overlay-title="Open The Power Menu" {spawn-sh "noctalia msg panel-toggle session"; }
    Mod+W hotkey-overlay-title="Open The Wallpaper Menu" {spawn-sh "noctalia msg panel-toggle wallpaper"; }
    Mod+Shift+W hotkey-overlay-title="Toggle The Top Bar" {spawn-sh "noctalia msg bar-toggle"; }
    Mod+ALT+L hotkey-overlay-title="To Lock Screen" { spawn-sh "noctalia msg screen-lock"; }

    // Audio & Brightness (V5)
    XF86MonBrightnessUp {spawn-sh "noctalia msg brightness-up";}
    XF86MonBrightnessDown {spawn-sh "noctalia msg brightness-down";}
    XF86AudioRaiseVolume {spawn-sh "noctalia msg volume-up";}
    XF86AudioLowerVolume {spawn-sh "noctalia msg volume-down";}
    XF86AudioMute {spawn-sh "noctalia msg volume-mute";}

    // Focus navigation (Vim style + Arrow keys)
    Mod+Left  { focus-column-left; }
    Mod+ALT+Down  { focus-workspace-down; }
    Mod+ALT+Up    { focus-workspace-up; }
    Mod+Right { focus-column-right; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+K { focus-window-up; }
    Mod+J { focus-window-down; }

    // Move windows (arrow keys)
    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Right { move-column-right; }

    // Move column/window - Vim style
    Ctrl+Shift+H { move-column-left; }
    Ctrl+Shift+L { move-column-right; }
    Ctrl+Shift+K { move-window-up; }
    Ctrl+Shift+J { move-window-down; }
    Mod+ALT+J  { focus-workspace-down; }
    Mod+ALT+K    { focus-workspace-up; }

    Mod+Shift+H { focus-monitor-left; }
    Mod+Shift+J { focus-monitor-down; }
    Mod+Shift+K { focus-monitor-up; }
    Mod+Shift+L { focus-monitor-right; }

    Mod+Ctrl+H { move-window-to-monitor-left; }
    Mod+Ctrl+J { move-window-to-monitor-down; }
    Mod+Ctrl+K { move-window-to-monitor-up; }
    Mod+Ctrl+L { move-window-to-monitor-right; }



    // Wokspaces navigation
    Mod+Shift+Down{ move-window-to-workspace-down; }
    Mod+Shift+Up { move-window-to-workspace-up; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    CTRL+1 { move-column-to-workspace 1; }
    CTRL+2 { move-column-to-workspace 2; }
    CTRL+3 { move-column-to-workspace 3; }
    CTRL+4 { move-column-to-workspace 4; }
    CTRL+5 { move-column-to-workspace 5; }
    CTRL+6 { move-column-to-workspace 6; }
    CTRL+7 { move-column-to-workspace 7; }
    CTRL+8 { move-column-to-workspace 8; }
    CTRL+9 { move-column-to-workspace 9; }

    Mod+BracketLeft { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }

    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R { reset-window-height; }

    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+M { maximize-window-to-edges; }
    Mod+Ctrl+F { expand-column-to-available-width; }

    Mod+C { center-column; }
    Mod+Ctrl+C { center-visible-columns; }

    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }

    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    Mod+V { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }


    // Screenshots
    Mod+ALT+S hotkey-overlay-title="Take The Screen-Shot Of Screen"{ screenshot; }
    Mod+ALT+W hotkey-overlay-title="Take The Screen-Shot Of Active Window" { screenshot-window; }
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+E { quit; }
    Ctrl+Alt+Delete { quit; }
    Mod+Shift+P { power-off-monitors; }
    Mod+D repeat=false { toggle-overview; }
    Mod+Shift+Slash { show-hotkey-overlay; }

}
